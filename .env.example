# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://aibde:aibde@localhost:5432/aibde

# Redis — used for send locks, daily caps, and seq:due ZSET scheduler
REDIS_URL=redis://localhost:6379

# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_API_KEY=dev-webhook-key-change-me
HITL_ACTOR=user:local-dev

# SMTP (dispatcher) — leave empty to log-only dry-run
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Discord incoming webhook (optional) — HITL approve enqueue + high-intent replies
# Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
# Keep this in the monorepo root `.env` (apps/web/next.config.ts loads it).
DISCORD_WEBHOOK_URL=

# Cal.com webhook secret (optional)
CAL_WEBHOOK_SECRET=

# Embeddings stub — Phase 1 logs intent; wire OpenAI later
EMBEDDING_PROVIDER=stub

# LLM (optional) — Research + Copywriter use OpenAI-compatible chat.
# Without a key, agents stay on deterministic-v1. With a key, LLM drafts
# are validated for grounding; violations fail closed to deterministic.
OPENAI_API_KEY=
# Or: LLM_API_KEY=
OPENAI_BASE_URL=
# Or: LLM_BASE_URL=   (default https://api.openai.com/v1)
OPENAI_MODEL=
# Or: LLM_MODEL=      (default gpt-4o-mini)

# Dispatcher poll interval (ms)
DISPATCHER_POLL_MS=5000

# Phase 2B Discover (job-board / RSS hiring signals)
# Default fetcher is fixture JSON — no LinkedIn scrape; emails never invented.
DISCOVER_SOURCE_KIND=fixture
# DISCOVER_FIXTURE_PATH=   # optional override; defaults to worker fixtures
# Live feeds (optional): comma-separated allowlist of exact URL prefixes
DISCOVER_FEED_ALLOWLIST=
# DISCOVER_RSS_URL=       # must be on DISCOVER_FEED_ALLOWLIST
# DISCOVER_API_URL=       # must be on DISCOVER_FEED_ALLOWLIST
# Set to 1 to allow HTTP website enrichment for allowlisted domains only
DISCOVER_WEBSITE_HTTP=0
