# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://aibde:aibde@localhost:5432/aibde

# Redis
REDIS_URL=redis://localhost:6379

# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_API_KEY=dev-webhook-key-change-me
HITL_ACTOR=user:local-dev

# SMTP (dispatcher) — leave empty to log-only in Phase 1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cal.com webhook secret (optional Phase 1)
CAL_WEBHOOK_SECRET=

# Embeddings stub — Phase 1 logs intent; wire OpenAI later
EMBEDDING_PROVIDER=stub
